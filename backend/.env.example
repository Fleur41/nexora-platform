# Copy to backend/.env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Local (non-Docker) defaults; docker-compose overrides these for containers.
DATABASE_URL=postgres://nexora:nexora_dev_password@localhost:5432/nexora
REDIS_URL=redis://localhost:6379/0
# Run background tasks inline when no Celery worker is running (local dev only).
# docker-compose sets this to false and runs a worker container.
CELERY_TASK_ALWAYS_EAGER=true

NEXORA_FRONTEND_URL=http://localhost:3000
NEXORA_DEFAULT_CURRENCY=KES
NEXORA_DEFAULT_TIMEZONE=Africa/Nairobi

# Email: console backend prints emails to the server log. With Docker, Mailpit is used.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Nexora <no-reply@nexora.local>

INVITATION_TTL_DAYS=7
LOG_LEVEL=INFO
