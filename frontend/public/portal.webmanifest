{
  "id": "/portal",
  "name": "Nexora Tenant",
  "short_name": "My home",
  "description": "Your rent, bills, receipts and repairs in one place.",
  "start_url": "/portal",
  "scope": "/portal",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0b2545",
  "categories": ["lifestyle", "finance", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pay rent", "url": "/portal/pay", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Report a repair", "url": "/portal/maintenance?new=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
