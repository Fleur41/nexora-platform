# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env (never commit it)
# and keep a copy in the password manager: without NEXORA_FIELD_ENCRYPTION_KEY, saved M-Pesa
# credentials in a restored backup cannot be decrypted.

NEXORA_DOMAIN=app.nexora.co.ke
ACME_EMAIL=ops@nexora.co.ke
NEXORA_VERSION=2026.11.1

# --- Secrets (generate fresh values; see docs/runbooks/deployment.md) ---
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
NEXORA_FIELD_ENCRYPTION_KEY=

# --- Django ---
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.nexora.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.nexora.co.ke
NEXORA_FRONTEND_URL=https://app.nexora.co.ke
NEXORA_PUBLIC_API_URL=https://app.nexora.co.ke
NEXORA_DEFAULT_CURRENCY=KES
NEXORA_DEFAULT_TIMEZONE=Africa/Nairobi
LOG_LEVEL=INFO

# --- Email (transactional SMTP provider) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Nexora <no-reply@nexora.co.ke>

# --- Safaricom callbacks: only accept these source addresses (comma-separated). ---
# Get the current list from Safaricom; leave empty only while testing in the sandbox.
MPESA_CALLBACK_ALLOWED_IPS=

# --- Nexora's own billing (subscriptions) ---
NEXORA_TRIAL_DAYS=30
NEXORA_TRIAL_PLAN=growth
NEXORA_PAYBILL=
NEXORA_BANK_NAME=
NEXORA_BANK_ACCOUNT=
NEXORA_MPESA_ENVIRONMENT=production
NEXORA_MPESA_CONSUMER_KEY=
NEXORA_MPESA_CONSUMER_SECRET=
NEXORA_MPESA_PASSKEY=

# --- Backups (deploy/backup.sh) ---
BACKUP_DIR=/var/backups/nexora
BACKUP_KEEP_DAYS=14
# Off-site copy with rclone (configure the remote once with `rclone config`). Empty = local only.
BACKUP_RCLONE_REMOTE=
# Backups are encrypted (AES-256, openssl) with this passphrase. Keep it in the password manager,
# separately from the server: a backup is useless without it.
BACKUP_PASSPHRASE=
